{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileLens",
  "version": "0.1.0",
  "identifier": "local.filelens.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node .tools/npm/bin/npm-cli.js run dev",
    "beforeBuildCommand": "node .tools/npm/bin/npm-cli.js run build"
  },
  "app": { "windows": [{ "title": "FileLens", "width": 1180, "height": 820, "minWidth": 820, "minHeight": 620 }] },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.svg"] }
}
