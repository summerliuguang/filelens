{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileLens",
  "version": "0.1.0",
  "identifier": "local.filelens.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": { "windows": [{ "title": "FileLens", "width": 1180, "height": 820, "minWidth": 820, "minHeight": 620 }] },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.svg"
    ]
  }
}
